<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="30dp"
        android:id="@+id/leftguideLinesignup"

       />


    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="30dp"
        android:id="@+id/rightGuideLinesignup"/>


    <androidx.constraintlayout.widget.Barrier
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"


        android:id="@+id/signupBarrier"
        app:constraint_referenced_ids="signuppasstv,signupnametv,signupEmail,signupNum"/>





    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Register!!"
        android:id="@+id/registertv"
        android:textSize="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="60dp"
        app:layout_constraintStart_toStartOf="@id/leftguideLinesignup"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/signupnametv"
        app:layout_constraintEnd_toEndOf="parent"/>



    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signupnametv"
        android:layout_marginTop="150dp"
        android:paddingTop="10dp"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/leftguideLinesignup"

        app:layout_constraintTop_toBottomOf="@id/registertv"
        android:text="Username"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signupnameet"
        android:hint="Enter username"
        app:layout_constraintEnd_toEndOf="@id/rightGuideLinesignup"
        android:layout_marginTop="150dp"
        android:layout_marginLeft="10dp"



        app:layout_constraintStart_toEndOf="@id/signupBarrier"
        app:layout_constraintTop_toBottomOf="@id/registertv"
        />


    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signuppasstv"
        android:layout_marginTop="50dp"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/leftguideLinesignup"
        android:paddingTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/signupnametv"

        android:text="Password"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signuppasset"
        android:layout_marginTop="50dp"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="@id/rightGuideLinesignup"
        app:layout_constraintStart_toEndOf="@id/signupBarrier"
        android:layout_marginLeft="10dp"
        app:layout_constraintTop_toBottomOf="@id/signupnameet"
        android:hint="Enter password"/>



    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signupNum"
        android:text="Number"
        android:layout_marginTop="50dp"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/leftguideLinesignup"
        android:paddingTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/signuppasstv"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signupNumet"
        android:hint="Enter Number"
        android:inputType="number"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        app:layout_constraintStart_toEndOf="@id/signupBarrier"
        app:layout_constraintEnd_toEndOf="@id/rightGuideLinesignup"
        app:layout_constraintTop_toBottomOf="@id/signuppasset"/>



    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signupEmail"
        android:text="Email"
        android:paddingTop="20dp"
        android:layout_marginTop="45dp"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/leftguideLinesignup"

        app:layout_constraintTop_toBottomOf="@id/signupNum"/>

    <EditText
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/signupEmailet"
        android:inputType="textEmailAddress"
        android:layout_marginLeft="10dp"
        android:hint="Enter email"
        android:layout_marginTop="50dp"
        app:layout_constraintStart_toEndOf="@id/signupBarrier"

        app:layout_constraintEnd_toEndOf="@id/rightGuideLinesignup"
        app:layout_constraintTop_toBottomOf="@id/signupNumet"/>

    <Button
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Register"
        android:id="@+id/sigupButton"
        app:layout_constraintStart_toEndOf="@id/leftguideLinesignup"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/signupEmail"/>





</androidx.constraintlayout.widget.ConstraintLayout>